Algoritmo "Calcular volume de uma caixa"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson Costas Dos Santos
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Daniel De Souza
// Data atual  : 13/09/2026
Var
// Seção de Declarações das variáveis 
      comprimento: inteiro
      largura: inteiro
      altura: inteiro
      volume: real
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
       Escreval("Bem vindo ao calculo de volume de uma caixa")
       Escreval("Iremos calcular o volume de uma caixa de tenis da nike")
       Escreval("Digite o comprimento da sua caixa")
       Leia(comprimento)
       Escreval("Agora digite a largura da sua caixa")
       Leia(largura)
       Escreval("Agora digite a altura da sua caixa")
       Leia(altura)
       timer 2000
       Escreval("Agora é so fazemos a formula do calculo de volume")
       Escreval("..............")
       timer 2000
       volume<- comprimento * largura * altura
       Escreval(" O VOLUME TOTAL DA CAIXA É:",volume)

Fimalgoritmo