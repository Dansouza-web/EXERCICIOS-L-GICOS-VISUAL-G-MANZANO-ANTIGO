Algoritmo "Ler dois inteiros variáveis A e B"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson Costas Dos Santos
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Daniel De Souza
// Data atual  : 14/09/2026
Var
   // Seção de Declarações das variáveis
   A: inteiro
   B: inteiro
   quadradodadiferenca: real

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
     Escreval("Adicione um valor a primeira variavel")
     Leia(A)
     Escreval("Agora adicione o valor da segunda variavel")
     Leia(B)
     quadradodadiferenca<- (A - B) * (A - B)
     Escreval("o quadrado da diferenca do primeiro valor é:",quadradodadiferenca)
     

Fimalgoritmo