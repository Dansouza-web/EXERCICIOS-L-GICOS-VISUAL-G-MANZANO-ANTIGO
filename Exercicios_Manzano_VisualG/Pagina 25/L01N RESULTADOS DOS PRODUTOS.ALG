Algoritmo "Resultados dos produtos"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson Costas Dos Santos
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Daniel De Souza
// Data atual  : 14/09/2026
Var
   // Seção de Declarações das variáveis
   A:inteiro
   B: inteiro
   C: inteiro
   D: inteiro
   calcularP: real
   calcularS: real
Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("Bem vindo ao calculo dos resultados dos produtos")
   Escreval("Digite o valor da Variavel A:")
   Leia(A)
   Escreval("Digite o valor da Variavel B:")
   Leia(B)
   Escreval("Digite o valor da Variavel C:")
   Leia(C)
   Escreval("Digite o valor da Variavel D:")
   Leia(D)
   calcularP<- A*C
   calcularS<- B+D
   Escreval("O resultado do produto é:",calcularP)
   Escreval("O resultado da soma é:",calcularS)
Fimalgoritmo