Algoritmo "Quadrado da soma"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson Costas Dos Santos
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Daniel De Souza
// Data atual  : 14/09/2026
Var
   // Seção de Declarações das variáveis
   A: real
   B: real
   C: real
   quadradodasoma: real
Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("Digite um valor para a variavel a:")
   Leia(A)
   Escreval("Digite um valor para b variavel a:")
   Leia(B)
   Escreval("Digite um valor para c variavel a:")
   Leia(C)
   quadradodasoma<- (A+B+C) * (A+B+C)
   Escreval("Esse é o valor do quadrado da soma das variaveis",quadradodasoma)
Fimalgoritmo